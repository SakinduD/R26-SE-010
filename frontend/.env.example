VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_MEDIAPIPE_FACE_MESH_URL=https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh
VITE_AVATAR_URL=/avatar.glb

# RPE NPC voice: 'managed' routes through the backend TTS manager (Chirp 3
# HD — see Backend/app/services/tts/), which falls back to the existing
# Google TTS (/api/gtts) and then the browser's own SpeechSynthesis if
# Chirp3 fails. 'google' skips the manager entirely — original pre-Chirp
# behavior, unchanged. See src/lib/rpe/ttsConfig.js.
VITE_RPE_TTS_PROVIDER=managed